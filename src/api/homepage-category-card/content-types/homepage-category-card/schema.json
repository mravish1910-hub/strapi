    "images": { "type": "media", "multiple": true, "required": false, "allowedTypes": ["images"] },
    "mobileImages": { "type": "media", "multiple": true, "required": false, "allowedTypes": ["images"], "description": "Portrait/square images optimised for mobile. Falls back to images[] if empty." },
    "imageRotateMs": { "type": "integer", "default": 3000, "description": "Auto-rotate interval in ms (0 = disabled)" },
    "active": { "type": "boolean", "default": true }
  }
